__pycache__/
*.pyc
.venv/
venv/
.DS_Store
*.log

# Local secrets. SENTRY_SECRET_KEY signs session cookies, so a committed .env
# would mean anyone with repo access can forge a session.
.env

# SQLite databases, including the WAL sidecar files.
*.db
*.db-shm
*.db-wal

# Editor/tooling scratch
.claude/
.idea/
.vscode/

# Training corpora. CIC-IDS2017 is ~884MB of CSV plus a cached .npz of the
# sampled rows; it is downloaded, not authored here. backend/app/ml/cicids.py
# reads whatever lives in data/cicids2017/, so the path is the contract, not
# the files. Fetch it from https://www.unb.ca/cic/datasets/ids-2017.html
data/

# Rejected model artifacts kept locally as evidence, never shipped. The
# CIC-only model reports 97.5% accuracy and detects 0% of the floods and 0% of
# the scans this system actually generates — loading it by accident would give
# a calm green dashboard while nothing is caught. See backend/artifacts/ for
# the model that is served.
backend/artifacts-cicids/
