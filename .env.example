# SENTRY configuration. Copy to .env and fill in. Every variable is optional
# except SENTRY_SECRET_KEY in production, which the app refuses to start
# without.
#
#   cp .env.example .env

# ── security ────────────────────────────────────────────────────────────────
# Signs the session cookies. Anyone who has this value can forge a session for
# any account, so treat it like a private key: never commit it, never reuse the
# development value, and rotate it if it leaks (rotating logs everyone out).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTRY_SECRET_KEY=

# How long a session lasts. 12h by default — long enough for a shift, short
# enough that a stolen cookie expires on its own.
# SENTRY_ACCESS_TOKEN_TTL_MINUTES=720

# Defaults to true in production. Only set this to false if you are testing
# over plain HTTP on localhost; a Secure cookie is never sent over HTTP, so
# leaving it true there means you cannot stay logged in.
# SENTRY_COOKIE_SECURE=true

# ── environment ─────────────────────────────────────────────────────────────
# "production" turns on HSTS, Secure cookies, and the startup checks below.
SENTRY_ENV=development

# ── database ────────────────────────────────────────────────────────────────
# SQLite is fine for a single-node install; the file must live on a persistent
# volume or every redeploy wipes the accounts.
SENTRY_DATABASE_URL=sqlite:///./sentry.db
# Postgres — note the +psycopg (v3) dialect. A bare postgresql:// URL asks for
# psycopg2, which is not installed.
# SENTRY_DATABASE_URL=postgresql+psycopg://user:password@host:5432/sentry

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API with credentials. If the app
# serves the dashboard itself this is same-origin and only needs your real
# hostname. "*" is rejected at startup in production: cookies are sent with
# these requests, so a wildcard would let any site on the internet read this
# API as the logged-in user.
SENTRY_CORS_ORIGINS=http://localhost:8000

# ── detection engine ────────────────────────────────────────────────────────
# Generates synthetic flows and scores them with the real model. Unset means on
# in development, off in production. Turning it on in production means an
# operator cannot distinguish a fabricated incident from a real one — only do
# that for a demo.
# SENTRY_SIMULATOR_ENABLED=false
# SENTRY_SIMULATOR_INTERVAL_MS=1200

# Confidence above which a prediction is promoted to an incident.
# SENTRY_DEFAULT_THRESHOLD=0.85

# Flows kept in the rolling in-memory window shown on the dashboard.
# SENTRY_RETAIN_FLOWS=5000

# ── CICIDS2017 replay ───────────────────────────────────────────────────────
# When set, the simulator cycles through CIC-IDS2017 CSV files from this
# directory instead of generating synthetic traffic. Leave unset in development
# and CI — the synthetic generator runs automatically as a fallback.
#
# Download the dataset (free, requires a Kaggle account):
#   https://www.kaggle.com/datasets/cicdataset/cicids2017
#
# Drop the extracted CSVs into the directory you point this at, then restart.
# The engine loads all *.csv files it finds and shuffles them so attack traffic
# is distributed rather than arriving in one block at the end.
#
# SENTRY_CICIDS_DATA_DIR=/path/to/CIC-IDS2017

# ── model artifacts ─────────────────────────────────────────────────────────
# Defaults to backend/artifacts, resolved relative to the package rather than
# the working directory. Override only if you mount the model elsewhere.
# SENTRY_MODEL_DIR=/app/backend/artifacts
