# Keep the build context small and, more importantly, keep secrets out of the
# image. Anything COPY'd in is readable by anyone who can pull the image.

.git
.gitignore
.github

# Secrets. Never bake these in — pass them at runtime with --env-file or the
# platform's own secret store.
.env
.env.*
!.env.example

# Local databases. Shipping one would mean every deployment starts with a stale
# copy of somebody's dev accounts.
*.db
*.db-shm
*.db-wal

# Host virtualenvs contain platform-specific binaries that would shadow the
# ones installed in the image.
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache

# Editor/tooling scratch
.claude
.idea
.vscode
.DS_Store
*.log

# Not needed at runtime.
backend/tests
README.md
